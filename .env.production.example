# ============================================================================
# 环境变量模板（占位符，不含真实密钥）
# 用法：cp .env.production.example .env.production，然后填入真实值
# ============================================================================

# ===== Django =====
# 生成密钥：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=请运行上面的命令生成随机密钥
DJANGO_DEBUG=False

# ===== PostgreSQL =====
DB_HOST=db
DB_NAME=data_platform
DB_USER=data_platform_user
DB_PASSWORD=改成你自己的强密码

# ===== Redis =====
REDIS_URL=redis://redis:6379/1

# ===== DeepSeek（NL2SQL 主链路：生成 SQL + 图表推荐 + 推荐查询）=====
# 获取 API Key：https://platform.deepseek.com/api_keys
LLM_API_KEY=sk-your-deepseek-key
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== 智谱（few-shot 语义检索：问题向量化，embedding-3 1024 维）=====
# 获取 API Key：https://open.bigmodel.cn/usercenter/apikeys
# 为什么和 DeepSeek 分开？DeepSeek 不提供 embedding 接口，智谱 embedding-3 性价比高
EMBEDDING_API_KEY=your-zhipu-key
EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4

# ===== 部署 =====
ALLOWED_HOSTS=你的域名或服务器IP
